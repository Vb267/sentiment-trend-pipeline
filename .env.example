# Copy this file to .env and adjust as needed. Never commit the real .env.

# ---- Source selection ----
# one of: bluesky, reddit
SOURCE=bluesky

# Bluesky Jetstream firehose - free, real-time, no credentials required.
BLUESKY_WANTED_COLLECTIONS=app.bsky.feed.post

# Reddit via PRAW - only used if SOURCE=reddit. Create a free "script" app at
# https://www.reddit.com/prefs/apps to get a client id/secret (no cost, just signup).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentiment-pipeline/0.1 by YOUR_REDDIT_USERNAME
REDDIT_SUBREDDITS=news

# ---- Sentiment backend ----
# vader       = instant, no download, rule-based; weaker on sarcasm/slang.
# transformer = cardiffnlp/twitter-roberta-base-sentiment-latest; ~500MB
#               download on first run, slower per message, more accurate.
SENTIMENT_BACKEND=vader

# ---- Kafka / Redpanda ----
# localhost:19092 when running producer/processor directly on the host (uv run ...).
# docker-compose overrides this to redpanda:9092 for the in-container services.
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_RAW=raw_posts
KAFKA_CONSUMER_GROUP=sentiment-processor

# ---- Storage ----
# Phase 1 writes SQLite. Phase 3+ (the docker-compose processor) writes ClickHouse.
SQLITE_PATH=data/phase2.db

# ClickHouse - only read when running the processor directly on the host
# (uv run python -m processor.main). docker-compose sets its own values for
# the in-container processor, matching the ClickHouse container's dev creds.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=pipeline
CLICKHOUSE_DATABASE=sentiment

# ---- Windowing & trend detection (Phase 3) ----
# Tumbling window length, processing-time.
WINDOW_MINUTES=5
# A term is "trending" when its mentions in a window are at least this many
# std devs above its trailing baseline...
TREND_ZSCORE_THRESHOLD=2.5
# ...measured over this many trailing windows (12 x 5min = 1h)...
TREND_BASELINE_WINDOWS=12
# ...once at least this many windows of baseline exist...
TREND_MIN_BASELINE_WINDOWS=3
# ...and only if it has at least this many mentions (tiny counts are noise).
# Terms below this are tracked but not written to ClickHouse.
TREND_MIN_COUNT=10

LOG_LEVEL=INFO
