{
  "uid": "sentiment-pipeline",
  "title": "Sentiment & Trends",
  "tags": [
    "sentiment-pipeline"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Posts, last 5 min",
      "description": "Raw posts scored in the last 5 minutes (live, not windowed).",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS posts FROM scored_posts WHERE processed_at > now() - INTERVAL 5 MINUTE"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Avg polarity, last 5 min",
      "description": "-1 = all negative, +1 = all positive, neutral posts count as 0.",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(avg(polarity), 3) AS polarity FROM scored_posts WHERE processed_at > now() - INTERVAL 5 MINUTE"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": -0.05
              },
              {
                "color": "green",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Trending terms in range",
      "description": "Distinct terms flagged (z >= threshold vs trailing baseline) in the selected range.",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count(DISTINCT term) AS terms FROM term_windows FINAL WHERE is_trending AND $__timeFilter(window_start)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Last closed window",
      "description": "End of the most recent window the processor has closed and written.",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT max(window_end) AS window_end FROM sentiment_windows"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Average sentiment per window",
      "description": "Mean signed polarity per source per tumbling window (processing-time).",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT window_start AS time, source, avg_polarity\nFROM sentiment_windows FINAL\nWHERE $__timeFilter(window_start)\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Volume and sentiment mix per window",
      "description": "Posts per window across all sources, stacked by sentiment label.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT window_start AS time,\n       sum(positive_count) AS positive,\n       sum(neutral_count) AS neutral,\n       sum(negative_count) AS negative\nFROM sentiment_windows FINAL\nWHERE $__timeFilter(window_start)\nGROUP BY time\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "positive"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "neutral"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "negative"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Trending terms",
      "description": "Terms whose mentions in a window were >= threshold std devs above their trailing baseline.",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT window_start AS window, term, mention_count AS mentions,\n       round(baseline_mean, 1) AS baseline_avg, round(zscore, 1) AS z\nFROM term_windows FINAL\nWHERE is_trending AND $__timeFilter(window_start)\nORDER BY window_start DESC, zscore DESC\nLIMIT 100"
        }
      ]
    },
    {
      "id": 8,
      "title": "Top terms, latest window",
      "description": "Busiest terms in the most recently closed window, trending or not.",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT term, mention_count AS mentions, round(baseline_mean, 1) AS baseline_avg,\n       round(zscore, 1) AS z, is_trending AS trending\nFROM term_windows FINAL\nWHERE window_start = (SELECT max(window_start) FROM term_windows)\nORDER BY mention_count DESC\nLIMIT 25"
        }
      ]
    },
    {
      "id": 9,
      "title": "Latest posts",
      "description": "Most recent scored posts (raw, not windowed).",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT processed_at AS time, source, sentiment_label AS label,\n       round(polarity, 2) AS polarity, text\nFROM scored_posts\nWHERE processed_at > now() - INTERVAL 1 HOUR\nORDER BY processed_at DESC\nLIMIT 100"
        }
      ]
    }
  ]
}
